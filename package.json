{
  "name": "@shishberg/agent-web",
  "version": "0.1.0",
  "type": "module",
  "module": "./dist/package/agent-web.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/package/agent-web.js"
    },
    "./style.css": "./dist/package/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude vite.config.ts.timestamp-* server/index.ts",
    "dev:web": "tsx watch --clear-screen=false --exclude vite.config.ts.timestamp-* server/index.ts",
    "dev:runner": "tsx watch --clear-screen=false --exclude vite.config.ts.timestamp-* server/runnerService.ts",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.package.json",
    "preview": "tsx server/index.ts --production",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@lucide/vue": "^1.16.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "markdown-it": "^14.1.1",
    "vite": "^5.4.19",
    "vue": "^3.5.13",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.18",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": ">=20"
  }
}
